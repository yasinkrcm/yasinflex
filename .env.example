# MongoDB bağlantı adresi (zorunlu)
MONGODB_URI=mongodb://localhost:27017/yasinflex

# JWT imzalama anahtarı — prod'da zorunlu! Üretin: openssl rand -hex 32
JWT_SECRET=

# TMDB API anahtarı — https://www.themoviedb.org/settings/api adresinden alın
# NEXT_PUBLIC_ öneki sayesinde istemciyle birlikte derlenir
NEXT_PUBLIC_TMDB_API_KEY=
